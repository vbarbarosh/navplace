#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

RED="\e[31m"
GREEN="\e[32m"
RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/release failed${RESET}"
trap 'echo -e "$EXIT_MESSAGE"' EXIT

cd $scriptdir/..

repo=`git rev-parse --show-toplevel`

MERGE_LOCK=$(test -e "$repo/MERGE_LOCK" && cat "$repo/MERGE_LOCK" | grep -v '^#'; true)
if test -n "$MERGE_LOCK"; then
    echo -e "${RED}error: releasing was locked${RESET} ⚠️"
    echo -e "${RED}${MERGE_LOCK}${RESET}"
    exit 1
fi

case "${1-}"  in
major|minor|patch)
    ;;
*)
    echo usage: release 'major|minor|patch' >&2
    exit 1
    ;;
esac

if test `git rev-parse --abbrev-ref HEAD` != master; then
    echo error: switch branch to master >&2
    exit 1
fi

if test -n "`git -C "$repo" status -s`"; then
    echo error: there is changes >&2
    exit 1
fi

# Increase a version without commiting it and making a tag
npm version $1 --no-git-tag-version

tag=electron-v$(node -e 'console.log(require("./package.json").version)')
if git rev-parse "$tag" >/dev/null 2>&1; then
    echo -e "${RED}error: tag $tag already exists${RESET}" >&2
    exit 1
fi

git add package.json
if test -e package-lock.json; then
    git add package-lock.json
fi
git commit -m "release $tag"

git tag $tag
git push origin master
git push origin $tag

EXIT_MESSAGE="${GREEN}bin/release succeeded${RESET}"

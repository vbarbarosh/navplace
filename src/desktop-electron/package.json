{
  "name": "navplace-desktop",
  "author": "Vladimir Barbarosh <vladimir.barbarosh@gmail.com>",
  "version": "1.4.0",
  "description": "The fastest way to open your links",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test 'helpers/**/*.test.js'"
  },
  "build": {
    "appId": "com.navplace",
    "productName": "NavPlace",
    "executableName": "navplace",
    "afterPack": "./afterPack.js",
    "directories": {
      "output": "build"
    },
    "files": [
      "**/*"
    ],
    "extraFiles": [
      {
        "from": "../../lib",
        "to": "lib"
      },
      {
        "from": "../../designs",
        "to": "designs"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@vbarbarosh/node-helpers": "^3.75.0",
    "@vbarbarosh/type-helpers": "^0.4.0",
    "axios": "^1.7.9",
    "bluebird": "^3.7.2",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.8.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}

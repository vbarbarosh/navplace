#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

BLACK="\e[30m" RED="\e[31m" GREEN="\e[32m" YELLOW="\e[33m" BLUE="\e[34m"
PURPLE="\e[35m" CYAN="\e[36m" WHITE="\e[37m" RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/build failed${RESET}"

# http://redsymbol.net/articles/bash-exit-traps/
# http://redsymbol.net/articles/unofficial-bash-strict-mode/#essential-cleanup
trap 'echo -e "$EXIT_MESSAGE"' EXIT

cd $scriptdir/..

rm -rf build/www
mkdir -p build

cp -r src/www/ build/
cp -r lib/ build/www/
cp -r designs/ build/www/
rm build/www/lib/*.cli.js
rm build/www/lib/*.test.js
# No page loads it: the Worker and the desktop app do, and lib/parse.js keeps its own copy
rm build/www/lib/is_public_domain.js

# The playground lists the designs from here, each with the files of its folder
node -e '
const fs = require("fs");
const names = fs.readdirSync("build/www/designs").filter(v => fs.existsSync(`build/www/designs/${v}/index.html`)).sort();
const options = names.map(v => ({value: v, label: v, files: fs.readdirSync(`build/www/designs/${v}`).sort()}));
fs.writeFileSync("build/www/designs/index.json", JSON.stringify(options, null, 4) + "\n");
'

# A build that fails its own check ships nothing
bin/self-check

EXIT_MESSAGE="${GREEN}bin/build succeeded${RESET}"

#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

RED="\e[31m" GREEN="\e[32m" RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/self-check failed${RESET}"

# http://redsymbol.net/articles/bash-exit-traps/
trap 'echo -e "$EXIT_MESSAGE"' EXIT
cd $scriptdir/..

# Each probe runs in its own strict shell; its lines carry its name.
(
    set -o nounset -o errexit -o pipefail
    node --version
) 2>&1 | sed 's/^/[node] /'

(
    set -o nounset -o errexit -o pipefail
    for file in index.html docs.html playground.html lib/navplace.js lib/parse.js lib/filter1_from_spec.js lib/items_search.js designs/index.json; do
        if [ ! -s build/www/$file ]; then
            echo "build/www/$file: missing, run bin/build"
            exit 1
        fi
    done
    echo "`node -p 'require("./build/www/designs/index.json").length'` designs, the pages and lib/"
) 2>&1 | sed 's/^/[build\/www] /'

# What is built can run: every script parses, and every file a page names is there
(
    set -o nounset -o errexit -o pipefail
    node -e '
const fs = require("fs");
const path = require("path");
const vm = require("vm");

const root = "build/www";
const faults = [];
const lib_files = fs.readdirSync(`${root}/lib`).filter(v => v.endsWith(".js")).map(v => `${root}/lib/${v}`);
const page_files = fs.readdirSync(root).filter(v => v.endsWith(".html")).map(v => `${root}/${v}`);
const design_files = fs.readdirSync(`${root}/designs`).map(v => `${root}/designs/${v}/index.html`).filter(v => fs.existsSync(v));

for (const file of lib_files) {
    script_check(fs.readFileSync(file, "utf8"), file);
}
for (const file of [...page_files, ...design_files]) {
    const html = fs.readFileSync(file, "utf8");
    let n = 0;
    const rest = html.replace(/<script\b([^>]*)>([\s\S]*?)<\/script>/g, function (all, attrs, code) {
        n += 1;
        if (!/\bsrc=/.test(attrs)) {
            script_check(code, `${file}, script ${n}`);
        }
        return `<script${attrs}></script>`;
    });
    // A static src or href only: v-bind:href, :src and the like belong to the page
    for (const match of rest.matchAll(/(?<![\w:-])(?:src|href)="([^"]*)"/g)) {
        const url = match[1];
        if (!url || /^(https?:|\/\/|#|data:|mailto:|javascript:)/.test(url) || url.includes("${") || url.includes("{{")) {
            continue;
        }
        const name = url.replace(/[?#].*$/, "");
        const target = name.startsWith("/") ? path.join(root, name) : path.join(path.dirname(file), name);
        if (!fs.existsSync(target)) {
            faults.push(`${file}: ${url} is not in the build`);
        }
    }
}
if (faults.length) {
    console.log(faults.join("\n"));
    process.exit(1);
}
console.log(`${lib_files.length} scripts of lib/, ${page_files.length} pages and ${design_files.length} designs parse, and name only files that are there`);

function script_check(code, name)
{
    try {
        new vm.Script(code, {filename: name});
    }
    catch (error) {
        faults.push(`${name}: ${error.message}`);
    }
}
'
) 2>&1 | sed 's/^/[build\/www] /'

# A design loads the shared libraries from /lib/…, never ../../lib/…
(
    set -o nounset -o errexit -o pipefail
    if grep -rl '\.\./\.\./lib/' designs/; then
        echo "the files above load ../../lib/…: make it /lib/…"
        exit 1
    fi
    echo "every design loads /lib/…"
) 2>&1 | sed 's/^/[designs] /'

# Every design has the light/dark switch (rules UI-01): /lib/theme_switch.js in its index.html
(
    set -o nounset -o errexit -o pipefail
    if grep -L '/lib/theme_switch.js' designs/*/index.html | grep .; then
        echo "the designs above have no /lib/theme_switch.js"
        exit 1
    fi
    echo "every design has the theme switch"
) 2>&1 | sed 's/^/[designs] /'

# Every design marks the link the runtime's Up/Down move to: the class np-current
(
    set -o nounset -o errexit -o pipefail
    missing=`for d in designs/*/; do grep -rqs 'np-current' $d || echo $d; done`
    if [ -n "$missing" ]; then
        echo "$missing"
        echo "the designs above do not mark the current link (np-current)"
        exit 1
    fi
    echo "every design marks the current link"
) 2>&1 | sed 's/^/[designs] /'

EXIT_MESSAGE="${GREEN}bin/self-check succeeded${RESET}"
